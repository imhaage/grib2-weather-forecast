{
  "name": "visualize",
  "private": true,
  "type": "module",
  "dependencies": {
    "@math.gl/web-mercator": "^4.1.0",
    "chroma-js": "^2.4.2",
    "comlink": "^4.4.2",
    "d3-contour": "^4.0.2",
    "grib2-decoder": "*",
    "idb": "^8.0.3",
    "maplibre-gl": "^4.7.1",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "scripts": {
    "build": "vite build",
    "check": "biome check src",
    "dev": "vite --host 0.0.0.0",
    "format": "biome format --write src",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "npm run build && npm run preview",
    "test": "vitest run src",
    "test:domain": "vitest run src/domain",
    "test:services": "vitest run src/services",
    "test:ui": "vitest run src/ui",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  }
}
